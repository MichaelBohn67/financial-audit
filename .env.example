# Copy to .env only for local development and keep the copied file untracked.
# Use a dedicated MariaDB user with the minimum required privileges.
FINANCIAL_AUDIT_DB_USERNAME=financial_audit
FINANCIAL_AUDIT_DB_PASSWORD=change-me

# Generate unique BCrypt hashes; never use example values in production.
FINANCIAL_AUDIT_AUDITOR_PASSWORD_HASH=
FINANCIAL_AUDIT_LEAD_AUDITOR_PASSWORD_HASH=
FINANCIAL_AUDIT_ADMIN_PASSWORD_HASH=

# PKCS12 keystore settings for the prod profile.
FINANCIAL_AUDIT_TLS_KEYSTORE=/secure/path/financial-audit.p12
FINANCIAL_AUDIT_TLS_KEYSTORE_PASSWORD=change-me
FINANCIAL_AUDIT_TLS_KEY_ALIAS=financial-audit
